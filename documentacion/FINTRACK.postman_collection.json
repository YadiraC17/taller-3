{
  "info": {
    "name": "FINTRACK API",
    "description": "Flujos principales de autenticación y finanzas personales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000/api" },
    { "key": "token", "value": "" },
    { "key": "categoriaId", "value": "1" },
    { "key": "presupuestoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario Demo\",\n  \"correo\": \"demo@fintrack.com\",\n  \"password\": \"ClaveSegura123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Iniciar sesión",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  pm.environment.set('token', pm.response.json().data.access_token);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"demo@fintrack.com\",\n  \"password\": \"ClaveSegura123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Mi perfil",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "Categorías y movimientos",
      "item": [
        {
          "name": "Crear categoría de gasto",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('categoriaId', pm.response.json().data.id_categoria);", "}"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Alimentación\",\n  \"tipo\": \"GASTO\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/categorias"
          }
        },
        {
          "name": "Listar categorías",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/categorias?tipo=GASTO" }
        },
        {
          "name": "Registrar gasto",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_categoria\": {{categoriaId}},\n  \"tipo\": \"GASTO\",\n  \"monto\": 45.50,\n  \"moneda\": \"PEN\",\n  \"descripcion\": \"Almuerzo\",\n  \"fecha\": \"2026-11-03\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/transacciones"
          }
        },
        {
          "name": "Listar transacciones",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/transacciones?moneda=PEN" }
        }
      ]
    },
    {
      "name": "Presupuestos e informes",
      "item": [
        {
          "name": "Crear presupuesto",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.environment.set('presupuestoId', pm.response.json().data.id_presupuesto);", "}"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_categoria\": {{categoriaId}},\n  \"monto_limite\": 500,\n  \"moneda\": \"PEN\",\n  \"mes\": 11,\n  \"anio\": 2026\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/presupuestos"
          }
        },
        {
          "name": "Seguimiento presupuestario",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/presupuestos/seguimiento?mes=11&anio=2026" }
        },
        {
          "name": "Resumen mensual",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/reportes/resumen?mes=11&anio=2026" }
        },
        {
          "name": "Gastos por categoría",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/reportes/gastos-categoria?mes=11&anio=2026" }
        },
        {
          "name": "Evolución anual",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/reportes/evolucion?anio=2026" }
        }
      ]
    }
  ]
}